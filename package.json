{
  "name": "losslesscutter",
  "productName": "LosslessCutter",
  "version": "1.0.0",
  "description": "无损音视频剪切工具 (Lossless Audio/Video Cutter)",
  "main": "electron/main.js",
  "author": "VibeCoding",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lossless-cut",
    "audio-cutter",
    "video-cutter",
    "trimmer",
    "ffmpeg",
    "electron",
    "mp3",
    "mp3gain",
    "flac",
    "wav",
    "wavesurfer"
  ],
  "scripts": {
    "build:renderer": "vite build",
    "start": "electron .",
    "dev": "vite build && electron .",
    "fetch:bin": "node scripts/fetch-binaries.js",
    "pack:win": "vite build && node scripts/pack-manual.js win32 x64",
    "pack:linux": "vite build && node scripts/pack-manual.js linux x64"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "adm-zip": "^0.5.16",
    "archiver": "^6.0.2",
    "electron": "^33.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "vite": "^6.0.3",
    "wavesurfer.js": "^7.9.4"
  }
}
